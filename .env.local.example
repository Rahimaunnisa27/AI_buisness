# ValidateAI Environment Variables
# Copy this file to .env.local: cp .env.local.example .env.local

# AI Provider: 'gemini' | 'openai' | 'mock'
# If no key is provided, ValidateAI automatically runs in smart mock mode with zero errors.
AI_PROVIDER=gemini

# Google Gemini API Key (Get free key from https://aistudio.google.com/)
GEMINI_API_KEY=

# Optional OpenAI API Key (if AI_PROVIDER=openai)
OPENAI_API_KEY=
